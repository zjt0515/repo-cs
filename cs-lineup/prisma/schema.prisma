generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  lineups Lineup[]
}

enum Map {
  DUST2
  MIRAGE
  INFERNO
  NUKE
  ANCIENT
  ANUBIS
  OVERPASS
  TRAIN
}

model Lineup {
  id Int @id @default(autoincrement())
  map Map
  name String
  throw_mode String
  desc String
  tags String
  aimImage String
  positionImage String
  effectImage String
  uploadUserId Int
  uploadUser User @relation(fields: [uploadUserId], references: [id])
}